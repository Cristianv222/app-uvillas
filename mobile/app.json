{
  "expo": {
    "name": "Uvillas",
    "slug": "uvillas",
    "scheme": "uvillas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.uvillas.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.uvillas.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Uvillas usa la cámara para diagnosticar hojas, tallos y frutos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Uvillas guarda la ubicación de cada diagnóstico (opcional)."
        }
      ],
      "react-native-fast-tflite"
    ]
  }
}
